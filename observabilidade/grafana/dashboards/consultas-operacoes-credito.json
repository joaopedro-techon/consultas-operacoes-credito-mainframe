{
  "uid": "consultas-operacoes-credito",
  "title": "Consultas de Operações de Crédito",
  "tags": ["consultas-operacoes-credito"],
  "timezone": "browser",
  "schemaVersion": 41,
  "version": 1,
  "refresh": "30s",
  "time": { "from": "now-1h", "to": "now" },
  "templating": {
    "list": [
      {
        "name": "consumidor",
        "label": "Consumidor",
        "type": "query",
        "datasource": { "type": "prometheus", "uid": "prometheus" },
        "query": { "query": "label_values(http_server_requests_seconds_count{uri=~\"/v1/operacoes-credito.*\"}, consumidor)", "refId": "consumidor" },
        "definition": "label_values(http_server_requests_seconds_count{uri=~\"/v1/operacoes-credito.*\"}, consumidor)",
        "includeAll": true,
        "multi": true,
        "allValue": ".*",
        "current": { "text": "All", "value": "$__all" },
        "refresh": 2
      },
      {
        "name": "tipo_consulta",
        "label": "Tipo de consulta",
        "type": "query",
        "datasource": { "type": "prometheus", "uid": "prometheus" },
        "query": { "query": "label_values(http_server_requests_seconds_count{uri=~\"/v1/operacoes-credito.*\"}, tipo_consulta)", "refId": "tipo_consulta" },
        "definition": "label_values(http_server_requests_seconds_count{uri=~\"/v1/operacoes-credito.*\"}, tipo_consulta)",
        "includeAll": true,
        "multi": true,
        "allValue": ".*",
        "current": { "text": "All", "value": "$__all" },
        "refresh": 2
      }
    ]
  },
  "panels": [
    {
      "id": 1,
      "type": "row",
      "title": "Latência",
      "collapsed": false,
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 0 },
      "panels": []
    },
    {
      "id": 2,
      "type": "timeseries",
      "title": "Latência P99 por tipo de consulta e rota",
      "description": "Alvo: OPERACAO 80 ms, CLIENTE/CONTA 200 ms (prazo 150/400 ms).",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 1 },
      "fieldConfig": { "defaults": { "unit": "s" }, "overrides": [] },
      "targets": [
        {
          "refId": "A",
          "expr": "histogram_quantile(0.99, sum by (le, tipo_consulta, rota) (rate(http_server_requests_seconds_bucket{uri=~\"/v1/operacoes-credito.*\", consumidor=~\"$consumidor\", tipo_consulta=~\"$tipo_consulta\"}[$__rate_interval])))",
          "legendFormat": "{{tipo_consulta}} / {{rota}}"
        }
      ]
    },
    {
      "id": 3,
      "type": "timeseries",
      "title": "Latência P50 por tipo de consulta e rota",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 1 },
      "fieldConfig": { "defaults": { "unit": "s" }, "overrides": [] },
      "targets": [
        {
          "refId": "A",
          "expr": "histogram_quantile(0.5, sum by (le, tipo_consulta, rota) (rate(http_server_requests_seconds_bucket{uri=~\"/v1/operacoes-credito.*\", consumidor=~\"$consumidor\", tipo_consulta=~\"$tipo_consulta\"}[$__rate_interval])))",
          "legendFormat": "{{tipo_consulta}} / {{rota}}"
        }
      ]
    },
    {
      "id": 4,
      "type": "timeseries",
      "title": "Latência P99 por dependência",
      "description": "Valkey, fonte primária e SQS (consultas.dependencia).",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 8, "w": 24, "x": 0, "y": 9 },
      "fieldConfig": { "defaults": { "unit": "s" }, "overrides": [] },
      "targets": [
        {
          "refId": "A",
          "expr": "histogram_quantile(0.99, sum by (le, dependencia, operacao) (rate(consultas_dependencia_seconds_bucket[$__rate_interval])))",
          "legendFormat": "{{dependencia}} {{operacao}}"
        }
      ]
    },
    {
      "id": 5,
      "type": "row",
      "title": "Erros",
      "collapsed": false,
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 17 },
      "panels": []
    },
    {
      "id": 6,
      "type": "timeseries",
      "title": "Requisições por status",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 18 },
      "fieldConfig": { "defaults": { "unit": "reqps" }, "overrides": [] },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (status) (rate(http_server_requests_seconds_count{uri=~\"/v1/operacoes-credito.*\", consumidor=~\"$consumidor\", tipo_consulta=~\"$tipo_consulta\"}[$__rate_interval]))",
          "legendFormat": "{{status}}"
        }
      ]
    },
    {
      "id": 7,
      "type": "timeseries",
      "title": "Taxa de erro (5xx) por tipo de consulta",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 18 },
      "fieldConfig": { "defaults": { "unit": "percentunit", "min": 0 }, "overrides": [] },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (tipo_consulta) (rate(http_server_requests_seconds_count{uri=~\"/v1/operacoes-credito.*\", status=~\"5..\", consumidor=~\"$consumidor\", tipo_consulta=~\"$tipo_consulta\"}[$__rate_interval])) / sum by (tipo_consulta) (rate(http_server_requests_seconds_count{uri=~\"/v1/operacoes-credito.*\", consumidor=~\"$consumidor\", tipo_consulta=~\"$tipo_consulta\"}[$__rate_interval]))",
          "legendFormat": "{{tipo_consulta}}"
        }
      ]
    },
    {
      "id": 8,
      "type": "row",
      "title": "Uso",
      "collapsed": false,
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 26 },
      "panels": []
    },
    {
      "id": 9,
      "type": "bargauge",
      "title": "Blocos mais pedidos",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 8, "w": 8, "x": 0, "y": 27 },
      "options": { "orientation": "horizontal", "displayMode": "basic", "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false } },
      "fieldConfig": { "defaults": { "unit": "short" }, "overrides": [] },
      "targets": [
        {
          "refId": "A",
          "expr": "sort_desc(sum by (bloco) (increase(consultas_blocos_total{consumidor=~\"$consumidor\", tipo_consulta=~\"$tipo_consulta\"}[$__range])))",
          "legendFormat": "{{bloco}}",
          "instant": true
        }
      ]
    },
    {
      "id": 10,
      "type": "timeseries",
      "title": "Consumo por consumidor",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 8, "w": 8, "x": 8, "y": 27 },
      "fieldConfig": { "defaults": { "unit": "reqps" }, "overrides": [] },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (consumidor) (rate(http_server_requests_seconds_count{uri=~\"/v1/operacoes-credito.*\", consumidor=~\"$consumidor\", tipo_consulta=~\"$tipo_consulta\"}[$__rate_interval]))",
          "legendFormat": "{{consumidor}}"
        }
      ]
    },
    {
      "id": 11,
      "type": "table",
      "title": "Blocos por consumidor",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 8, "w": 8, "x": 16, "y": 27 },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (consumidor, bloco) (increase(consultas_blocos_total{consumidor=~\"$consumidor\", tipo_consulta=~\"$tipo_consulta\"}[$__range]))",
          "format": "table",
          "instant": true
        }
      ],
      "transformations": [
        { "id": "organize", "options": { "excludeByName": { "Time": true }, "renameByName": { "Value": "solicitações" } } }
      ]
    },
    {
      "id": 12,
      "type": "row",
      "title": "Fonte primária por custódia",
      "collapsed": false,
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 35 },
      "panels": []
    },
    {
      "id": 13,
      "type": "timeseries",
      "title": "Chamadas ao mainframe por custódia e operação",
      "description": "Cada página e cada tentativa é uma chamada (ADR-0014/0016). operacao = bloco ou lista_cliente/lista_conta.",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 36 },
      "fieldConfig": { "defaults": { "unit": "reqps" }, "overrides": [] },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (custodia, operacao) (rate(consultas_dependencia_seconds_count{dependencia=\"fonte_primaria\"}[$__rate_interval]))",
          "legendFormat": "{{custodia}} / {{operacao}}"
        }
      ]
    },
    {
      "id": 14,
      "type": "timeseries",
      "title": "Latência P99 do mainframe por custódia",
      "description": "Premissa do modelo de capacidade: p50 220 ms, p99 500 ms; timeout por tentativa 700 ms.",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 36 },
      "fieldConfig": { "defaults": { "unit": "s" }, "overrides": [] },
      "targets": [
        {
          "refId": "A",
          "expr": "histogram_quantile(0.99, sum by (le, custodia) (rate(consultas_dependencia_seconds_bucket{dependencia=\"fonte_primaria\"}[$__rate_interval])))",
          "legendFormat": "{{custodia}} p99"
        },
        {
          "refId": "B",
          "expr": "histogram_quantile(0.5, sum by (le, custodia) (rate(consultas_dependencia_seconds_bucket{dependencia=\"fonte_primaria\"}[$__rate_interval])))",
          "legendFormat": "{{custodia}} p50"
        }
      ]
    },
    {
      "id": 15,
      "type": "timeseries",
      "title": "Descoberta de custódia por rota, custódia e resultado",
      "description": "resultado: cache, encontrada, nao_encontrada, indisponivel (ADR-0012). Taxa de cache baixa aumenta as chamadas ao mainframe (4 OPERACAO por consulta).",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 44 },
      "fieldConfig": { "defaults": { "unit": "ops" }, "overrides": [] },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (rota, custodia, resultado) (rate(consultas_custodia_descoberta_total[$__rate_interval]))",
          "legendFormat": "{{rota}} / {{custodia}} / {{resultado}}"
        }
      ]
    },
    {
      "id": 16,
      "type": "timeseries",
      "title": "Operações em mais de uma custódia",
      "description": "Duplicidade resolvida pela precedência NSF > SF > F5 > OD (ADR-0012).",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 44 },
      "fieldConfig": { "defaults": { "unit": "ops" }, "overrides": [] },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (rota) (rate(consultas_custodia_duplicada_total[$__rate_interval]))",
          "legendFormat": "{{rota}}"
        }
      ]
    },
    {
      "id": 17,
      "type": "row",
      "title": "Resiliência (Resilience4j)",
      "collapsed": false,
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 52 },
      "panels": []
    },
    {
      "id": 18,
      "type": "stat",
      "title": "Circuitos abertos agora",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 8, "w": 4, "x": 0, "y": 53 },
      "options": { "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false }, "colorMode": "background" },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "thresholds": { "mode": "absolute", "steps": [ { "color": "green", "value": null }, { "color": "red", "value": 1 } ] }
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "count(max by (name) (resilience4j_circuitbreaker_state{state=~\"open|forced_open\"}) == 1) or vector(0)",
          "instant": true
        }
      ]
    },
    {
      "id": 19,
      "type": "timeseries",
      "title": "Circuit breakers fora de CLOSED",
      "description": "Instâncias fontePrimaria-<custodia>-<bloco|lista_cliente|lista_conta>, valkey e sqs. 1 = no estado.",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 8, "w": 20, "x": 4, "y": 53 },
      "fieldConfig": { "defaults": { "unit": "short", "min": 0, "max": 1, "custom": { "drawStyle": "line", "lineInterpolation": "stepAfter" } }, "overrides": [] },
      "targets": [
        {
          "refId": "A",
          "expr": "max by (name, state) (resilience4j_circuitbreaker_state{state=~\"open|half_open|forced_open\"}) == 1",
          "legendFormat": "{{name}} {{state}}"
        }
      ]
    },
    {
      "id": 20,
      "type": "timeseries",
      "title": "Retries por instância e resultado",
      "description": "kind: successful_with_retry, failed_with_retry, failed_without_retry (sem o caso sem retry e com sucesso). Cada tentativa consome a cota do mainframe.",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 61 },
      "fieldConfig": { "defaults": { "unit": "ops" }, "overrides": [] },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (name, kind) (rate(resilience4j_retry_calls_total{kind!=\"successful_without_retry\"}[$__rate_interval]))",
          "legendFormat": "{{name}} {{kind}}"
        }
      ]
    },
    {
      "id": 21,
      "type": "timeseries",
      "title": "Chamadas por circuito e resultado",
      "description": "failed conta no circuito; ignored são as falhas da própria aplicação (prazo, recusas; ADR-0009/0010).",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 61 },
      "fieldConfig": { "defaults": { "unit": "ops" }, "overrides": [] },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (name, kind) (rate(resilience4j_circuitbreaker_calls_seconds_count{kind=~\"failed|ignored\"}[$__rate_interval]))",
          "legendFormat": "{{name}} {{kind}}"
        }
      ]
    },
    {
      "id": 22,
      "type": "row",
      "title": "Cota e recusas",
      "collapsed": false,
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 69 },
      "panels": []
    },
    {
      "id": 23,
      "type": "timeseries",
      "title": "Chamadas ao mainframe (todas as tasks) × cota",
      "description": "Soma das tentativas e páginas de todas as tasks. Linha vermelha: cota de 1.500 chamadas/s (ADR-0015; ajuste o threshold se a cota mudar).",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 70 },
      "fieldConfig": {
        "defaults": {
          "unit": "reqps",
          "min": 0,
          "custom": { "thresholdsStyle": { "mode": "line" } },
          "thresholds": { "mode": "absolute", "steps": [ { "color": "green", "value": null }, { "color": "red", "value": 1500 } ] }
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(rate(consultas_dependencia_seconds_count{dependencia=\"fonte_primaria\"}[$__rate_interval]))",
          "legendFormat": "chamadas/s"
        }
      ]
    },
    {
      "id": 24,
      "type": "timeseries",
      "title": "Respostas 429 por rota",
      "description": "Na fonte primária: cota local da task esgotada (rate limiter fontePrimaria). Contado à parte do 503.",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 70 },
      "fieldConfig": { "defaults": { "unit": "reqps" }, "overrides": [] },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (rota, tipo_consulta) (rate(http_server_requests_seconds_count{uri=~\"/v1/operacoes-credito.*\", status=\"429\", consumidor=~\"$consumidor\", tipo_consulta=~\"$tipo_consulta\"}[$__rate_interval]))",
          "legendFormat": "{{rota}} / {{tipo_consulta}}"
        }
      ]
    },
    {
      "id": 25,
      "type": "timeseries",
      "title": "Chamadas recusadas pelo circuito (aberto)",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 8, "w": 8, "x": 0, "y": 78 },
      "fieldConfig": { "defaults": { "unit": "ops" }, "overrides": [] },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (name) (rate(resilience4j_circuitbreaker_not_permitted_calls_total[$__rate_interval])) > 0",
          "legendFormat": "{{name}}"
        }
      ]
    },
    {
      "id": 26,
      "type": "timeseries",
      "title": "Vagas livres nos bulkheads (mínimo entre tasks)",
      "description": "Perto de zero: recusas (503) a seguir. fontePrimaria-<custodia>, fontePrimaria-cliente-conta, sqs.",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 8, "w": 8, "x": 8, "y": 78 },
      "fieldConfig": { "defaults": { "unit": "short", "min": 0 }, "overrides": [] },
      "targets": [
        {
          "refId": "A",
          "expr": "min by (name) (resilience4j_bulkhead_available_concurrent_calls)",
          "legendFormat": "{{name}}"
        }
      ]
    },
    {
      "id": 27,
      "type": "timeseries",
      "title": "Permissões livres nos rate limiters (mínimo entre tasks)",
      "description": "fontePrimaria = cota ÷ máximo de tasks por período; zero = 429.",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 8, "w": 8, "x": 16, "y": 78 },
      "fieldConfig": { "defaults": { "unit": "short", "min": 0 }, "overrides": [] },
      "targets": [
        {
          "refId": "A",
          "expr": "min by (name) (resilience4j_ratelimiter_available_permissions)",
          "legendFormat": "{{name}}"
        }
      ]
    }
  ]
}
